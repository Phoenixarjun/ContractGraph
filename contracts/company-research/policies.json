{
  "version": "1.0.0",
  "models": {
    "planning": {
      "draft": "sonnet",
      "supervisor": "opus"
    },
    "research": {
      "primary": "sonnet",
      "triage": "haiku"
    },
    "verification": {
      "section": "sonnet",
      "global": "opus"
    },
    "repair": {
      "structural": "haiku",
      "semantic": "sonnet"
    }
  },
  "execution": {
    "maxParallelNodes": 4,
    "maxRetriesPerNode": 2,
    "retryFailedNodesOnly": true,
    "deterministicAggregation": true,
    "workerCannotSelfApprove": true,
    "concurrencyModes": {
      "default": 4,
      "timeBounded": 8,
      "tokenEfficient": 2
    },
    "tokenEfficientBatching": true
  },
  "evidence": {
    "requireReachableUrls": true,
    "requireClaimLevelEvidence": true,
    "preferPrimarySources": true,
    "candidateReportClaimsRequireQualification": true,
    "singleAnecdoteCannotBecomeFrequencyClaim": true,
    "sourcePriority": [
      "official_regulatory",
      "official",
      "official_documentation",
      "official_engineering",
      "job_posting",
      "research_paper",
      "reputable_news",
      "candidate_report",
      "community"
    ]
  },
  "freshnessDays": {
    "activeJobPosting": 30,
    "hiringSignals": 90,
    "compensation": 180,
    "interviewProcess": 540,
    "recentDevelopments": 180,
    "companyStructure": 365,
    "foundationalEngineeringMaterial": 1825
  },
  "privacy": {
    "privateContextMustNotEnterSkills": true,
    "privateContextMustNotEnterPublicExamples": true,
    "derivedContextMustPreserveProvenance": true,
    "canonicalContextIsImmutableDuringRun": true
  },
  "tokenEfficiency": {
    "reuseVerifiedSkills": true,
    "loadContextByRelevance": true,
    "cacheContextSummaries": true,
    "passEvidenceSummariesToOpus": true,
    "doNotPassFullTranscriptsBetweenNodes": true,
    "canonicalFormat": "json",
    "toonMode": "benchmark_before_enable"
  }
}
