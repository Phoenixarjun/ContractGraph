{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.dev/contracts/company-research/roles/role.schema.json",
  "title": "Target Role Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "roleId",
    "displayName",
    "aliases",
    "levels",
    "mission",
    "requiredDomains",
    "interviewEmphasis",
    "evaluationWeights"
  ],
  "properties": {
    "roleId": {
      "$ref": "common/common.schema.json#/$defs/RoleId"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "requiredDomains": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "preferredDomains": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "interviewEmphasis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evaluationWeights": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "minimumEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "truthRisks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
