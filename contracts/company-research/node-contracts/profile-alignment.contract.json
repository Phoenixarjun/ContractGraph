{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.dev/contracts/company-research/nodes/profile-alignment.contract.json",
  "title": "Profile Alignment Contract",
  "description": "Maps canonical candidate evidence to the company and target roles, producing fit scores, green flags, red flags, gaps, truthful positioning, level assessment, and reusable cross-role evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodeId",
    "contractVersion",
    "status",
    "data",
    "sources",
    "contextEvidence",
    "verification"
  ],
  "properties": {
    "nodeId": {
      "const": "profile-alignment"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "positioning": {
          "type": "string",
          "minLength": 1
        },
        "overallRecommendation": {
          "type": "string",
          "minLength": 1
        },
        "roleAssessments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "roleId": {
                "$ref": "../common/common.schema.json#/$defs/RoleId"
              },
              "priority": {
                "type": "integer",
                "minimum": 1
              },
              "fitScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "targetLevel": {
                "type": "string",
                "minLength": 1
              },
              "greenFlags": {
                "type": "array",
                "items": {
                  "$ref": "../common/common.schema.json#/$defs/CandidateEvidenceMapping"
                },
                "minItems": 1
              },
              "redFlags": {
                "type": "array",
                "items": {
                  "$ref": "../common/common.schema.json#/$defs/CandidateEvidenceMapping"
                },
                "minItems": 1
              },
              "mustKnow": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "niceToKnow": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "companySpecificKnowledge": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "currentGaps": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "eligibilityRisks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "recommendedPositioning": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "roleId",
              "priority",
              "fitScore",
              "targetLevel",
              "greenFlags",
              "redFlags",
              "mustKnow",
              "niceToKnow",
              "companySpecificKnowledge",
              "currentGaps",
              "eligibilityRisks",
              "recommendedPositioning"
            ]
          },
          "minItems": 5
        },
        "transferableEvidence": {
          "type": "array",
          "items": {
            "$ref": "../common/common.schema.json#/$defs/CandidateEvidenceMapping"
          },
          "minItems": 1
        },
        "projectSelectionRule": {
          "type": "string",
          "minLength": 1
        },
        "experienceAssessment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "safeStatement": {
              "type": "string",
              "minLength": 1
            },
            "recognizedExperience": {
              "type": "string",
              "minLength": 1
            },
            "training": {
              "type": [
                "string",
                "null"
              ]
            },
            "doNotClaim": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "required": [
            "safeStatement",
            "recognizedExperience",
            "training",
            "doNotClaim"
          ]
        },
        "metadata": {
          "$ref": "../common/common.schema.json#/$defs/ResearchMetadata"
        }
      },
      "required": [
        "positioning",
        "overallRecommendation",
        "roleAssessments",
        "transferableEvidence",
        "projectSelectionRule",
        "experienceAssessment",
        "metadata"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/EvidenceSource"
      }
    },
    "contextEvidence": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/ContextEvidence"
      }
    },
    "verification": {
      "$ref": "../common/common.schema.json#/$defs/NodeVerification"
    }
  },
  "x-contractgraph": {
    "purpose": "Maps canonical candidate evidence to the company and target roles, producing fit scores, green flags, red flags, gaps, truthful positioning, level assessment, and reusable cross-role evidence.",
    "aggregationPath": "profileAlignment",
    "dependsOn": [
      "company-intelligence",
      "company-initiatives",
      "role-intelligence",
      "domain-knowledge"
    ],
    "parallelizableWhenReady": true,
    "multiplicity": "single",
    "completionRules": [
      "The output must validate against this schema.",
      "status must be complete before the node can be accepted.",
      "Every material research claim must resolve to at least one evidence source.",
      "Every candidate-specific claim must resolve to canonical context evidence.",
      "The producing subagent cannot approve its own output.",
      "Semantic verification must pass before aggregation."
    ]
  }
}
