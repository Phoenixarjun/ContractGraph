{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.dev/contracts/company-research/nodes/hld.contract.json",
  "title": "HLD Contract",
  "description": "Produces company- and role-specific high-level system-design questions with requirements, scale, APIs, data models, architecture, consistency, partitioning, reliability, security, observability, rollout, evidence, and project mapping.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodeId",
    "contractVersion",
    "status",
    "data",
    "sources",
    "contextEvidence",
    "verification"
  ],
  "properties": {
    "nodeId": {
      "const": "hld"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "canonicalKey": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "designType": {
                "type": "string",
                "enum": [
                  "HLD",
                  "LLD"
                ]
              },
              "priority": {
                "type": "integer",
                "minimum": 1
              },
              "estimatedInterviewMinutes": {
                "type": "integer",
                "minimum": 1
              },
              "frequencyClass": {
                "type": "string",
                "enum": [
                  "explicitly_reported",
                  "repeatedly_reported",
                  "company_specific_recommended",
                  "company_relevant_recommended",
                  "general_recommended",
                  "unknown"
                ]
              },
              "roleApplicability": {
                "type": "array",
                "items": {
                  "$ref": "../common/common.schema.json#/$defs/RoleApplicability"
                },
                "minItems": 1
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "resourceLinks": {
                "type": "array",
                "items": {
                  "$ref": "../common/common.schema.json#/$defs/ResourceLink"
                },
                "minItems": 1
              },
              "interviewerSignal": {
                "type": "string",
                "minLength": 1
              },
              "requirementsToClarify": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "functionalRequirements": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "nonFunctionalRequirements": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "scaleAndCapacityPrompts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "coreEntitiesOrComponents": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "apiSketch": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "dataModelSketch": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "recommendedPatterns": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "thoughtProcess": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "answerOutline": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "failureModesAndTradeoffs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "securityAndPrivacy": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "observabilityAndRollout": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "likelyFollowUpQuestions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "companySpecificAngle": {
                "type": "string",
                "minLength": 1
              },
              "candidateProjectMapping": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "projectRef": {
                      "type": "string",
                      "minLength": 1
                    },
                    "relevance": {
                      "type": "string",
                      "minLength": 1
                    },
                    "truthBoundary": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "projectRef",
                    "relevance",
                    "truthBoundary"
                  ]
                }
              },
              "canonicalMatching": {
                "$ref": "../common/common.schema.json#/$defs/CanonicalMatching"
              },
              "localTracking": {
                "$ref": "../common/common.schema.json#/$defs/LocalTracking"
              },
              "metadata": {
                "$ref": "../common/common.schema.json#/$defs/ResearchMetadata"
              }
            },
            "required": [
              "canonicalKey",
              "title",
              "designType",
              "priority",
              "estimatedInterviewMinutes",
              "frequencyClass",
              "roleApplicability",
              "evidenceRefs",
              "resourceLinks",
              "interviewerSignal",
              "requirementsToClarify",
              "functionalRequirements",
              "nonFunctionalRequirements",
              "scaleAndCapacityPrompts",
              "coreEntitiesOrComponents",
              "apiSketch",
              "dataModelSketch",
              "recommendedPatterns",
              "thoughtProcess",
              "answerOutline",
              "failureModesAndTradeoffs",
              "securityAndPrivacy",
              "observabilityAndRollout",
              "likelyFollowUpQuestions",
              "companySpecificAngle",
              "candidateProjectMapping",
              "canonicalMatching",
              "localTracking",
              "metadata"
            ]
          },
          "minItems": 1
        },
        "evaluationRubric": {
          "type": "array",
          "items": {
            "$ref": "../common/common.schema.json#/$defs/EvaluationDimension"
          },
          "minItems": 1
        },
        "answerFramework": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "roleExpectations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "roleId": {
                "$ref": "../common/common.schema.json#/$defs/RoleId"
              },
              "depth": {
                "type": "string",
                "enum": [
                  "foundation",
                  "intermediate",
                  "advanced",
                  "expert"
                ]
              },
              "expectedSignals": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "commonFailureModes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "required": [
              "roleId",
              "depth",
              "expectedSignals",
              "commonFailureModes"
            ]
          },
          "minItems": 5
        },
        "metadata": {
          "$ref": "../common/common.schema.json#/$defs/ResearchMetadata"
        }
      },
      "required": [
        "questions",
        "evaluationRubric",
        "answerFramework",
        "roleExpectations",
        "metadata"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/EvidenceSource"
      },
      "minItems": 1
    },
    "contextEvidence": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/ContextEvidence"
      }
    },
    "verification": {
      "$ref": "../common/common.schema.json#/$defs/NodeVerification"
    }
  },
  "x-contractgraph": {
    "purpose": "Produces company- and role-specific high-level system-design questions with requirements, scale, APIs, data models, architecture, consistency, partitioning, reliability, security, observability, rollout, evidence, and project mapping.",
    "aggregationPath": "hld",
    "dependsOn": [
      "company-intelligence",
      "company-initiatives",
      "role-intelligence",
      "interview-process"
    ],
    "parallelizableWhenReady": true,
    "multiplicity": "single",
    "completionRules": [
      "The output must validate against this schema.",
      "status must be complete before the node can be accepted.",
      "Every material research claim must resolve to at least one evidence source.",
      "Every candidate-specific claim must resolve to canonical context evidence.",
      "The producing subagent cannot approve its own output.",
      "Semantic verification must pass before aggregation."
    ]
  }
}
