{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.dev/contracts/company-research/nodes/interview-process.contract.json",
  "title": "Interview Process Contract",
  "description": "Produces a role-aware, evidence-backed interview-loop model while clearly separating common patterns from team-specific and anecdotal variation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodeId",
    "contractVersion",
    "status",
    "data",
    "sources",
    "contextEvidence",
    "verification"
  ],
  "properties": {
    "nodeId": {
      "const": "interview-process"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "typicalRounds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "focus": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "expectedOutputs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "roleApplicability": {
                "type": "array",
                "items": {
                  "$ref": "../common/common.schema.json#/$defs/RoleApplicability"
                },
                "minItems": 1
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "confidence": {
                "$ref": "../common/common.schema.json#/$defs/Confidence"
              }
            },
            "required": [
              "order",
              "name",
              "focus",
              "expectedOutputs",
              "roleApplicability",
              "evidenceRefs",
              "confidence"
            ]
          },
          "minItems": 1
        },
        "estimatedDuration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "planningRange": {
              "type": "string",
              "minLength": 1
            },
            "qualification": {
              "type": "string",
              "minLength": 1
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "planningRange",
            "qualification",
            "evidenceRefs"
          ]
        },
        "roleVariations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "roleId": {
                "$ref": "../common/common.schema.json#/$defs/RoleId"
              },
              "expectedRounds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "highestRisks": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "preparationPriorities": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "roleId",
              "expectedRounds",
              "highestRisks",
              "preparationPriorities",
              "evidenceRefs"
            ]
          },
          "minItems": 5
        },
        "processVariability": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "recruiterQuestionsToConfirm": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "metadata": {
          "$ref": "../common/common.schema.json#/$defs/ResearchMetadata"
        }
      },
      "required": [
        "typicalRounds",
        "estimatedDuration",
        "roleVariations",
        "processVariability",
        "recruiterQuestionsToConfirm",
        "metadata"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/EvidenceSource"
      },
      "minItems": 1
    },
    "contextEvidence": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/ContextEvidence"
      }
    },
    "verification": {
      "$ref": "../common/common.schema.json#/$defs/NodeVerification"
    }
  },
  "x-contractgraph": {
    "purpose": "Produces a role-aware, evidence-backed interview-loop model while clearly separating common patterns from team-specific and anecdotal variation.",
    "aggregationPath": "interviewProcess",
    "dependsOn": [
      "company-intelligence",
      "role-intelligence"
    ],
    "parallelizableWhenReady": true,
    "multiplicity": "single",
    "completionRules": [
      "The output must validate against this schema.",
      "status must be complete before the node can be accepted.",
      "Every material research claim must resolve to at least one evidence source.",
      "Every candidate-specific claim must resolve to canonical context evidence.",
      "The producing subagent cannot approve its own output.",
      "Semantic verification must pass before aggregation."
    ]
  }
}
