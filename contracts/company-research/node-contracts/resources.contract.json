{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.dev/contracts/company-research/nodes/resources.contract.json",
  "title": "Resources Contract",
  "description": "Collects, deduplicates, categorizes, and prioritizes all verified learning, evidence, practice, and official resources emitted by accepted nodes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodeId",
    "contractVersion",
    "status",
    "data",
    "sources",
    "contextEvidence",
    "verification"
  ],
  "properties": {
    "nodeId": {
      "const": "resources"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "official_company",
                  "engineering_blog",
                  "documentation",
                  "interview_reports",
                  "dsa_practice",
                  "hld",
                  "lld",
                  "cs_fundamentals",
                  "behavioral",
                  "role_domain",
                  "github",
                  "course",
                  "book",
                  "paper",
                  "video",
                  "other"
                ]
              },
              "resources": {
                "type": "array",
                "items": {
                  "$ref": "../common/common.schema.json#/$defs/ResourceLink"
                },
                "minItems": 1
              }
            },
            "required": [
              "category",
              "resources"
            ]
          },
          "minItems": 1
        },
        "mustReadFirst": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "resourceUrl": {
                "type": "string",
                "format": "uri"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "roleApplicability": {
                "type": "array",
                "items": {
                  "$ref": "../common/common.schema.json#/$defs/RoleApplicability"
                },
                "minItems": 1
              }
            },
            "required": [
              "rank",
              "resourceUrl",
              "reason",
              "roleApplicability"
            ]
          },
          "minItems": 1
        },
        "researchGaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deduplicationReport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputUrlCount": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueUrlCount": {
              "type": "integer",
              "minimum": 0
            },
            "removedDuplicates": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "inputUrlCount",
            "uniqueUrlCount",
            "removedDuplicates"
          ]
        },
        "metadata": {
          "$ref": "../common/common.schema.json#/$defs/ResearchMetadata"
        }
      },
      "required": [
        "categories",
        "mustReadFirst",
        "researchGaps",
        "deduplicationReport",
        "metadata"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/EvidenceSource"
      },
      "minItems": 1
    },
    "contextEvidence": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/ContextEvidence"
      }
    },
    "verification": {
      "$ref": "../common/common.schema.json#/$defs/NodeVerification"
    }
  },
  "x-contractgraph": {
    "purpose": "Collects, deduplicates, categorizes, and prioritizes all verified learning, evidence, practice, and official resources emitted by accepted nodes.",
    "aggregationPath": "resources",
    "dependsOn": [
      "company-intelligence",
      "company-initiatives",
      "dsa",
      "cs-fundamentals",
      "domain-knowledge",
      "hld",
      "lld",
      "behavioral"
    ],
    "parallelizableWhenReady": true,
    "multiplicity": "single",
    "completionRules": [
      "The output must validate against this schema.",
      "status must be complete before the node can be accepted.",
      "Every material research claim must resolve to at least one evidence source.",
      "Every candidate-specific claim must resolve to canonical context evidence.",
      "The producing subagent cannot approve its own output.",
      "Semantic verification must pass before aggregation."
    ]
  }
}
