{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.dev/contracts/company-research/nodes/role-intelligence.contract.json",
  "title": "Role Intelligence Contract",
  "description": "Researches the target company's role expectations, titles, levels, responsibilities, skill requirements, locations, teams, and current job-posting evidence for the configured role set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodeId",
    "contractVersion",
    "status",
    "data",
    "sources",
    "contextEvidence",
    "verification"
  ],
  "properties": {
    "nodeId": {
      "const": "role-intelligence"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "roleId": {
                "$ref": "../common/common.schema.json#/$defs/RoleId"
              },
              "roleTitles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "targetLevels": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "locations": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "likelyTeams": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "responsibilities": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "requiredSkills": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "preferredSkills": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "experienceExpectations": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "interviewEmphasis": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "activeJobPostings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "requisitionId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "location": {
                      "type": "string",
                      "minLength": 1
                    },
                    "postedAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "active",
                        "closed",
                        "unknown"
                      ]
                    },
                    "evidenceRefs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "title",
                    "requisitionId",
                    "url",
                    "location",
                    "postedAt",
                    "status",
                    "evidenceRefs"
                  ]
                }
              },
              "roleRisks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "metadata": {
                "$ref": "../common/common.schema.json#/$defs/ResearchMetadata"
              }
            },
            "required": [
              "roleId",
              "roleTitles",
              "targetLevels",
              "locations",
              "likelyTeams",
              "responsibilities",
              "requiredSkills",
              "preferredSkills",
              "experienceExpectations",
              "interviewEmphasis",
              "activeJobPostings",
              "roleRisks",
              "metadata"
            ]
          },
          "minItems": 5
        },
        "crossRoleComparison": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dimension": {
                "type": "string",
                "minLength": 1
              },
              "roleScores": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "interpretation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "dimension",
              "roleScores",
              "interpretation"
            ]
          }
        },
        "metadata": {
          "$ref": "../common/common.schema.json#/$defs/ResearchMetadata"
        }
      },
      "required": [
        "roles",
        "crossRoleComparison",
        "metadata"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/EvidenceSource"
      },
      "minItems": 1
    },
    "contextEvidence": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/ContextEvidence"
      }
    },
    "verification": {
      "$ref": "../common/common.schema.json#/$defs/NodeVerification"
    }
  },
  "x-contractgraph": {
    "purpose": "Researches the target company's role expectations, titles, levels, responsibilities, skill requirements, locations, teams, and current job-posting evidence for the configured role set.",
    "aggregationPath": "roleIntelligence",
    "dependsOn": [
      "company-intelligence"
    ],
    "parallelizableWhenReady": true,
    "multiplicity": "single",
    "completionRules": [
      "The output must validate against this schema.",
      "status must be complete before the node can be accepted.",
      "Every material research claim must resolve to at least one evidence source.",
      "Every candidate-specific claim must resolve to canonical context evidence.",
      "The producing subagent cannot approve its own output.",
      "Semantic verification must pass before aggregation."
    ]
  }
}
