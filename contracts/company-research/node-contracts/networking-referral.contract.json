{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.dev/contracts/company-research/nodes/networking-referral.contract.json",
  "title": "Networking and Referral Contract",
  "description": "Produces role-aware target personas, outreach sequence, message blueprints, referral package requirements, and follow-up policy grounded in company and candidate alignment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodeId",
    "contractVersion",
    "status",
    "data",
    "sources",
    "contextEvidence",
    "verification"
  ],
  "properties": {
    "nodeId": {
      "const": "networking-referral"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetPeople": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "persona": {
                "type": "string",
                "minLength": 1
              },
              "roleApplicability": {
                "type": "array",
                "items": {
                  "$ref": "../common/common.schema.json#/$defs/RoleApplicability"
                },
                "minItems": 1
              },
              "whyRelevant": {
                "type": "string",
                "minLength": 1
              },
              "searchSignals": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "persona",
              "roleApplicability",
              "whyRelevant",
              "searchSignals",
              "evidenceRefs"
            ]
          },
          "minItems": 1
        },
        "outreachSequence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "messageBlueprints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scenario": {
                "type": "string",
                "minLength": 1
              },
              "requiredInputs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "structure": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "avoid": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "required": [
              "scenario",
              "requiredInputs",
              "structure",
              "avoid"
            ]
          },
          "minItems": 1
        },
        "referralPackage": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "followUpPolicy": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "$ref": "../common/common.schema.json#/$defs/ResearchMetadata"
        }
      },
      "required": [
        "targetPeople",
        "outreachSequence",
        "messageBlueprints",
        "referralPackage",
        "followUpPolicy",
        "metadata"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/EvidenceSource"
      },
      "minItems": 1
    },
    "contextEvidence": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/ContextEvidence"
      }
    },
    "verification": {
      "$ref": "../common/common.schema.json#/$defs/NodeVerification"
    }
  },
  "x-contractgraph": {
    "purpose": "Produces role-aware target personas, outreach sequence, message blueprints, referral package requirements, and follow-up policy grounded in company and candidate alignment.",
    "aggregationPath": "networkingAndReferral",
    "dependsOn": [
      "company-intelligence",
      "role-intelligence",
      "profile-alignment"
    ],
    "parallelizableWhenReady": true,
    "multiplicity": "single",
    "completionRules": [
      "The output must validate against this schema.",
      "status must be complete before the node can be accepted.",
      "Every material research claim must resolve to at least one evidence source.",
      "Every candidate-specific claim must resolve to canonical context evidence.",
      "The producing subagent cannot approve its own output.",
      "Semantic verification must pass before aggregation."
    ]
  }
}
