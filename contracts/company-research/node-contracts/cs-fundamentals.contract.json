{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.dev/contracts/company-research/nodes/cs-fundamentals.contract.json",
  "title": "CS Fundamentals Contract",
  "description": "Produces role-specific preparation for programming language internals, OOP, operating systems, DBMS, networking, concurrency, distributed systems, testing, cloud/runtime, AI/ML foundations, and security.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodeId",
    "contractVersion",
    "status",
    "data",
    "sources",
    "contextEvidence",
    "verification"
  ],
  "properties": {
    "nodeId": {
      "const": "cs-fundamentals"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roleCoverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "roleId": {
                "$ref": "../common/common.schema.json#/$defs/RoleId"
              },
              "requiredCategories": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "depthExpectation": {
                "type": "string",
                "enum": [
                  "foundation",
                  "working",
                  "advanced",
                  "expert"
                ]
              },
              "highestRiskAreas": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "required": [
              "roleId",
              "requiredCategories",
              "depthExpectation",
              "highestRiskAreas"
            ]
          },
          "minItems": 5
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "topicId": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "enum": [
                  "programming_language",
                  "object_oriented_design",
                  "operating_systems",
                  "database_systems",
                  "computer_networks",
                  "concurrency",
                  "distributed_systems",
                  "software_engineering",
                  "testing",
                  "cloud_and_runtime",
                  "ai_ml_foundations",
                  "security"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "roleApplicability": {
                "type": "array",
                "items": {
                  "$ref": "../common/common.schema.json#/$defs/RoleApplicability"
                },
                "minItems": 1
              },
              "conceptsToMaster": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "interviewQuestions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "question": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expectedAnswerPoints": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    },
                    "commonMistakes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "followUps": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "evidenceRefs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "question",
                    "expectedAnswerPoints",
                    "commonMistakes",
                    "followUps",
                    "evidenceRefs"
                  ]
                },
                "minItems": 1
              },
              "practicalScenarios": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "resources": {
                "type": "array",
                "items": {
                  "$ref": "../common/common.schema.json#/$defs/ResourceLink"
                },
                "minItems": 1
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "metadata": {
                "$ref": "../common/common.schema.json#/$defs/ResearchMetadata"
              }
            },
            "required": [
              "topicId",
              "category",
              "title",
              "priority",
              "roleApplicability",
              "conceptsToMaster",
              "interviewQuestions",
              "practicalScenarios",
              "resources",
              "evidenceRefs",
              "metadata"
            ]
          },
          "minItems": 1
        },
        "crossTopicScenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scenario": {
                "type": "string",
                "minLength": 1
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2,
                "uniqueItems": true
              },
              "expectedReasoning": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "roleApplicability": {
                "type": "array",
                "items": {
                  "$ref": "../common/common.schema.json#/$defs/RoleApplicability"
                },
                "minItems": 1
              }
            },
            "required": [
              "scenario",
              "categories",
              "expectedReasoning",
              "roleApplicability"
            ]
          }
        },
        "studyOrder": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "metadata": {
          "$ref": "../common/common.schema.json#/$defs/ResearchMetadata"
        }
      },
      "required": [
        "roleCoverage",
        "topics",
        "crossTopicScenarios",
        "studyOrder",
        "metadata"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/EvidenceSource"
      },
      "minItems": 1
    },
    "contextEvidence": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/ContextEvidence"
      }
    },
    "verification": {
      "$ref": "../common/common.schema.json#/$defs/NodeVerification"
    }
  },
  "x-contractgraph": {
    "purpose": "Produces role-specific preparation for programming language internals, OOP, operating systems, DBMS, networking, concurrency, distributed systems, testing, cloud/runtime, AI/ML foundations, and security.",
    "aggregationPath": "csFundamentals",
    "dependsOn": [
      "role-intelligence",
      "interview-process"
    ],
    "parallelizableWhenReady": true,
    "multiplicity": "single",
    "completionRules": [
      "The output must validate against this schema.",
      "status must be complete before the node can be accepted.",
      "Every material research claim must resolve to at least one evidence source.",
      "Every candidate-specific claim must resolve to canonical context evidence.",
      "The producing subagent cannot approve its own output.",
      "Semantic verification must pass before aggregation."
    ]
  }
}
