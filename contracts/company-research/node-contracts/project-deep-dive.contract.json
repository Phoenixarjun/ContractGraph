{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.dev/contracts/company-research/nodes/project-deep-dive.contract.json",
  "title": "Project Deep-Dive Contract",
  "description": "Ranks candidate projects for the company and each target role, maps verified evidence and truth boundaries, and generates project-specific interview question packs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodeId",
    "contractVersion",
    "status",
    "data",
    "sources",
    "contextEvidence",
    "verification"
  ],
  "properties": {
    "nodeId": {
      "const": "project-deep-dive"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectRankings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "projectRef": {
                "type": "string",
                "minLength": 1
              },
              "projectName": {
                "type": "string",
                "minLength": 1
              },
              "roleApplicability": {
                "type": "array",
                "items": {
                  "$ref": "../common/common.schema.json#/$defs/RoleApplicability"
                },
                "minItems": 1
              },
              "companyConnections": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "initiativeRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "verifiedProof": {
                "type": "array",
                "items": {
                  "$ref": "../common/common.schema.json#/$defs/CandidateEvidenceMapping"
                },
                "minItems": 1
              },
              "truthBoundaries": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "overallFitScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "rank",
              "projectRef",
              "projectName",
              "roleApplicability",
              "companyConnections",
              "initiativeRefs",
              "verifiedProof",
              "truthBoundaries",
              "overallFitScore"
            ]
          },
          "minItems": 1
        },
        "questionPacks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "projectRef": {
                "type": "string",
                "minLength": 1
              },
              "roleId": {
                "$ref": "../common/common.schema.json#/$defs/RoleId"
              },
              "architectureQuestions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "implementationQuestions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "tradeoffQuestions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "failureAndReliabilityQuestions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "testingAndValidationQuestions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "securityQuestions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "scaleQuestions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ownershipQuestions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "expectedEvidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "projectRef",
              "roleId",
              "architectureQuestions",
              "implementationQuestions",
              "tradeoffQuestions",
              "failureAndReliabilityQuestions",
              "testingAndValidationQuestions",
              "securityQuestions",
              "scaleQuestions",
              "ownershipQuestions",
              "expectedEvidenceRefs"
            ]
          },
          "minItems": 1
        },
        "portfolioSelectionRules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "missingProjectEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "projectRef": {
                "type": "string",
                "minLength": 1
              },
              "missingEvidence": {
                "type": "string",
                "minLength": 1
              },
              "recommendedAction": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              }
            },
            "required": [
              "projectRef",
              "missingEvidence",
              "recommendedAction",
              "priority"
            ]
          }
        },
        "metadata": {
          "$ref": "../common/common.schema.json#/$defs/ResearchMetadata"
        }
      },
      "required": [
        "projectRankings",
        "questionPacks",
        "portfolioSelectionRules",
        "missingProjectEvidence",
        "metadata"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/EvidenceSource"
      }
    },
    "contextEvidence": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/ContextEvidence"
      }
    },
    "verification": {
      "$ref": "../common/common.schema.json#/$defs/NodeVerification"
    }
  },
  "x-contractgraph": {
    "purpose": "Ranks candidate projects for the company and each target role, maps verified evidence and truth boundaries, and generates project-specific interview question packs.",
    "aggregationPath": "projectDeepDive",
    "dependsOn": [
      "company-initiatives",
      "role-intelligence",
      "profile-alignment"
    ],
    "parallelizableWhenReady": true,
    "multiplicity": "single",
    "completionRules": [
      "The output must validate against this schema.",
      "status must be complete before the node can be accepted.",
      "Every material research claim must resolve to at least one evidence source.",
      "Every candidate-specific claim must resolve to canonical context evidence.",
      "The producing subagent cannot approve its own output.",
      "Semantic verification must pass before aggregation."
    ]
  }
}
