{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.dev/contracts/company-research/nodes/resume-analysis.contract.json",
  "title": "Resume Analysis Contract",
  "description": "Evaluates one or more resumes against all configured roles and company requirements, producing green flags, red flags, requirement mappings, truthful enhancement plans, project ordering, keyword guidance, and best-resume selection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodeId",
    "contractVersion",
    "status",
    "data",
    "sources",
    "contextEvidence",
    "verification"
  ],
  "properties": {
    "nodeId": {
      "const": "resume-analysis"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resumeInventory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resumeRef": {
                "type": "string",
                "minLength": 1
              },
              "fileName": {
                "type": "string",
                "minLength": 1
              },
              "contentHash": {
                "type": "string",
                "minLength": 1
              },
              "parsedSuccessfully": {
                "type": "boolean"
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "resumeRef",
              "fileName",
              "contentHash",
              "parsedSuccessfully",
              "issues"
            ]
          },
          "minItems": 1
        },
        "roleAnalyses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "roleId": {
                "$ref": "../common/common.schema.json#/$defs/RoleId"
              },
              "resumeRef": {
                "type": "string",
                "minLength": 1
              },
              "overallFitScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "screeningRisk": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "unknown"
                ]
              },
              "greenFlags": {
                "type": "array",
                "items": {
                  "$ref": "../common/common.schema.json#/$defs/CandidateEvidenceMapping"
                },
                "minItems": 1
              },
              "redFlags": {
                "type": "array",
                "items": {
                  "$ref": "../common/common.schema.json#/$defs/CandidateEvidenceMapping"
                },
                "minItems": 1
              },
              "requirementMapping": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "requirement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "importance": {
                      "type": "string",
                      "enum": [
                        "must_have",
                        "strong_preference",
                        "nice_to_have"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "met",
                        "partial",
                        "missing",
                        "unclear"
                      ]
                    },
                    "resumeEvidence": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    },
                    "canonicalContextRefs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    },
                    "recommendation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "jobEvidenceRefs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "requirement",
                    "importance",
                    "status",
                    "resumeEvidence",
                    "canonicalContextRefs",
                    "recommendation",
                    "jobEvidenceRefs"
                  ]
                },
                "minItems": 1
              },
              "sectionAssessment": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "section": {
                      "type": "string",
                      "minLength": 1
                    },
                    "strengths": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "weaknesses": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "changes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "section",
                    "strengths",
                    "weaknesses",
                    "changes"
                  ]
                },
                "minItems": 1
              },
              "projectOrdering": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "keywordsToAddOnlyIfTruthful": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "keywordsAlreadySupported": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "keywordsNotSupported": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "bulletEnhancementPlan": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "currentBulletRef": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "problem": {
                      "type": "string",
                      "minLength": 1
                    },
                    "recommendedRewriteGuidance": {
                      "type": "string",
                      "minLength": 1
                    },
                    "requiredEvidenceBeforeUse": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "truthRisk": {
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high"
                      ]
                    }
                  },
                  "required": [
                    "currentBulletRef",
                    "problem",
                    "recommendedRewriteGuidance",
                    "requiredEvidenceBeforeUse",
                    "truthRisk"
                  ]
                }
              },
              "companySpecificEnhancementPlan": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "interviewRisksCreatedByResume": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "truthGuardrails": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "bestResumeForRole": {
                "type": "boolean"
              }
            },
            "required": [
              "roleId",
              "resumeRef",
              "overallFitScore",
              "screeningRisk",
              "greenFlags",
              "redFlags",
              "requirementMapping",
              "sectionAssessment",
              "projectOrdering",
              "keywordsToAddOnlyIfTruthful",
              "keywordsAlreadySupported",
              "keywordsNotSupported",
              "bulletEnhancementPlan",
              "companySpecificEnhancementPlan",
              "interviewRisksCreatedByResume",
              "truthGuardrails",
              "bestResumeForRole"
            ]
          },
          "minItems": 5
        },
        "crossResumeRecommendation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recommendedResumeByRole": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "newVariantNeeded": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "roleId": {
                    "$ref": "../common/common.schema.json#/$defs/RoleId"
                  },
                  "needed": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "roleId",
                  "needed",
                  "reason"
                ]
              },
              "minItems": 5
            },
            "globalImprovements": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "required": [
            "recommendedResumeByRole",
            "newVariantNeeded",
            "globalImprovements"
          ]
        },
        "metadata": {
          "$ref": "../common/common.schema.json#/$defs/ResearchMetadata"
        }
      },
      "required": [
        "resumeInventory",
        "roleAnalyses",
        "crossResumeRecommendation",
        "metadata"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/EvidenceSource"
      }
    },
    "contextEvidence": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/ContextEvidence"
      }
    },
    "verification": {
      "$ref": "../common/common.schema.json#/$defs/NodeVerification"
    }
  },
  "x-contractgraph": {
    "purpose": "Evaluates one or more resumes against all configured roles and company requirements, producing green flags, red flags, requirement mappings, truthful enhancement plans, project ordering, keyword guidance, and best-resume selection.",
    "aggregationPath": "resumeAnalysis",
    "dependsOn": [
      "role-intelligence",
      "profile-alignment",
      "project-deep-dive"
    ],
    "parallelizableWhenReady": true,
    "multiplicity": "one-output-containing-all-configured-roles",
    "completionRules": [
      "The output must validate against this schema.",
      "status must be complete before the node can be accepted.",
      "Every material research claim must resolve to at least one evidence source.",
      "Every candidate-specific claim must resolve to canonical context evidence.",
      "The producing subagent cannot approve its own output.",
      "Semantic verification must pass before aggregation."
    ]
  }
}
