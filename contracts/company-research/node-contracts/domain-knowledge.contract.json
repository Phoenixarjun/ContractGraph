{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.dev/contracts/company-research/nodes/domain-knowledge.contract.json",
  "title": "Role Domain Knowledge Contract",
  "description": "Defines the role-specific backend, AI, ML, FDE, and software-engineering knowledge expected by the target company beyond generic CS fundamentals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodeId",
    "contractVersion",
    "status",
    "data",
    "sources",
    "contextEvidence",
    "verification"
  ],
  "properties": {
    "nodeId": {
      "const": "domain-knowledge"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roleDomains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "roleId": {
                "$ref": "../common/common.schema.json#/$defs/RoleId"
              },
              "positioning": {
                "type": "string",
                "minLength": 1
              },
              "mustKnow": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "niceToKnow": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "companySpecificKnowledge": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "currentRiskAreas": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "evaluationSignals": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "resources": {
                "type": "array",
                "items": {
                  "$ref": "../common/common.schema.json#/$defs/ResourceLink"
                },
                "minItems": 1
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "roleId",
              "positioning",
              "mustKnow",
              "niceToKnow",
              "companySpecificKnowledge",
              "currentRiskAreas",
              "evaluationSignals",
              "resources",
              "evidenceRefs"
            ]
          },
          "minItems": 5
        },
        "sharedFoundations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "metadata": {
          "$ref": "../common/common.schema.json#/$defs/ResearchMetadata"
        }
      },
      "required": [
        "roleDomains",
        "sharedFoundations",
        "metadata"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/EvidenceSource"
      },
      "minItems": 1
    },
    "contextEvidence": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/ContextEvidence"
      }
    },
    "verification": {
      "$ref": "../common/common.schema.json#/$defs/NodeVerification"
    }
  },
  "x-contractgraph": {
    "purpose": "Defines the role-specific backend, AI, ML, FDE, and software-engineering knowledge expected by the target company beyond generic CS fundamentals.",
    "aggregationPath": "domainKnowledge",
    "dependsOn": [
      "company-intelligence",
      "company-initiatives",
      "role-intelligence"
    ],
    "parallelizableWhenReady": true,
    "multiplicity": "single",
    "completionRules": [
      "The output must validate against this schema.",
      "status must be complete before the node can be accepted.",
      "Every material research claim must resolve to at least one evidence source.",
      "Every candidate-specific claim must resolve to canonical context evidence.",
      "The producing subagent cannot approve its own output.",
      "Semantic verification must pass before aggregation."
    ]
  }
}
