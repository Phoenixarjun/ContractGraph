{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.dev/contracts/study-plan/contract.schema.json",
  "title": "Personalized Study Plan Final Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "run",
    "studyPlanMeta",
    "baselineAssessment",
    "python",
    "fastapi",
    "databases",
    "distributedSystems",
    "evaluationPlan",
    "sourceRegistry"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "documentType": {
      "const": "PersonalizedStudyPlan"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "learnerGoal",
        "contractBundleVersion",
        "contextManifestHash"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "learnerGoal": {
          "type": "string",
          "minLength": 1
        },
        "contractBundleVersion": {
          "const": "1.0.0"
        },
        "contextManifestHash": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "studyPlanMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedAt",
        "timestampSource",
        "caveats",
        "scopeDisclaimer"
      ],
      "properties": {
        "generatedAt": {
          "type": ["string", "null"],
          "description": "ISO-8601 UTC with millisecond precision when measured; null (with timestampSource: 'unavailable') when no trustworthy real timestamp exists rather than a fabricated or unverifiable one."
        },
        "timestampSource": {
          "type": "string",
          "enum": ["measured", "unavailable"]
        },
        "caveats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "scopeDisclaimer": {
          "type": "string",
          "minLength": 1,
          "description": "Machine-checked (validate_final_output.py) human-readable statement that this is a backend-and-AI-systems study plan, not a complete career-preparation plan -- must name every contract.bundle.json scope.outOfScope topic (e.g. DSA) and point to its companionWorkflow."
        }
      }
    },
    "baselineAssessment": {
      "$ref": "node-contracts/baseline-assessment.contract.json#/properties/data"
    },
    "python": {
      "$ref": "node-contracts/python.contract.json#/properties/data"
    },
    "fastapi": {
      "$ref": "node-contracts/fastapi.contract.json#/properties/data"
    },
    "databases": {
      "$ref": "node-contracts/databases.contract.json#/properties/data"
    },
    "distributedSystems": {
      "$ref": "node-contracts/distributed-systems.contract.json#/properties/data"
    },
    "evaluationPlan": {
      "$ref": "node-contracts/evaluation-plan.contract.json#/properties/data"
    },
    "sourceRegistry": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common/common.schema.json#/$defs/EvidenceSource"
      }
    },
    "sourceGovernance": {
      "type": "object",
      "description": "Optional: per-node recommended/archived source split written by migrate_run_metadata.py's repair_source_governance. Optional (not in required[]) so final.json artifacts produced before this field existed remain valid.",
      "additionalProperties": false,
      "required": ["recommendedSources", "archivedSources"],
      "properties": {
        "recommendedSources": {
          "type": "object",
          "description": "nodeId -> best 5-10 ranked sources for that node.",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "object" }
          }
        },
        "archivedSources": {
          "type": "object",
          "description": "nodeId -> remaining valid but lower-ranked sources for that node.",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    }
  },
  "x-contractgraph": {
    "bundle": "contract.bundle.json",
    "aggregation": "deterministic",
    "globalVerifier": "opus"
  }
}
