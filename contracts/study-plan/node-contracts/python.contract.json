{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.dev/contracts/study-plan/nodes/python.contract.json",
  "title": "python contract",
  "description": "Produce a role-relevant python learning track with objectives, resources and milestones.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodeId",
    "contractVersion",
    "status",
    "data",
    "evidence",
    "verification"
  ],
  "properties": {
    "nodeId": {
      "const": "python"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "objectives",
        "resources",
        "milestones"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../common/common.schema.json#/$defs/ResourceLink"
          }
        },
        "milestones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "successCriteria"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "successCriteria": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "handoffSummary": {
          "$ref": "../common/common.schema.json#/$defs/HandoffSummary"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/EvidenceRef"
      }
    },
    "verification": {
      "$ref": "../common/common.schema.json#/$defs/NodeVerification"
    }
  },
  "x-contractgraph": {
    "purpose": "Produce a role-relevant python learning track with objectives, resources and milestones.",
    "aggregationPath": "python",
    "contextRefs": [
      "canonical/preferences.md"
    ],
    "dependsOn": [
      "baseline-assessment"
    ],
    "parallelizableWhenReady": true,
    "multiplicity": "single",
    "completionRules": [
      "Output validates against this schema.",
      "status must be complete to accept.",
      "Every learning claim cites a resource.",
      "Producer cannot self-approve."
    ]
  }
}
