{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.dev/contracts/study-plan/nodes/evaluation-plan.contract.json",
  "title": "evaluation-plan contract",
  "description": "Define checkpoints and a final assessment tying the topic tracks to the learner goal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodeId",
    "contractVersion",
    "status",
    "data",
    "evidence",
    "verification"
  ],
  "properties": {
    "nodeId": {
      "const": "evaluation-plan"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoints",
        "finalAssessment"
      ],
      "properties": {
        "checkpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topic",
              "criteria"
            ],
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "criteria": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "finalAssessment": {
          "type": "string",
          "minLength": 1
        },
        "handoffSummary": {
          "$ref": "../common/common.schema.json#/$defs/HandoffSummary"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/EvidenceRef"
      }
    },
    "verification": {
      "$ref": "../common/common.schema.json#/$defs/NodeVerification"
    }
  },
  "x-contractgraph": {
    "purpose": "Define checkpoints and a final assessment tying the topic tracks to the learner goal.",
    "aggregationPath": "evaluationPlan",
    "contextRefs": [
      "canonical/goals.md"
    ],
    "dependsOn": [
      "python",
      "fastapi",
      "databases",
      "distributed-systems"
    ],
    "parallelizableWhenReady": true,
    "multiplicity": "single",
    "completionRules": [
      "Output validates against this schema.",
      "status must be complete to accept.",
      "Every learning claim cites a resource.",
      "Producer cannot self-approve."
    ]
  }
}
