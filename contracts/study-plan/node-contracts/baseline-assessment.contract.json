{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.dev/contracts/study-plan/nodes/baseline-assessment.contract.json",
  "title": "baseline-assessment contract",
  "description": "Assess the learner's current level and gaps from canonical goals/knowledge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodeId",
    "contractVersion",
    "status",
    "data",
    "sources",
    "verification"
  ],
  "properties": {
    "nodeId": {
      "const": "baseline-assessment"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentLevel",
        "gaps",
        "priorKnowledgeRefs"
      ],
      "properties": {
        "currentLevel": {
          "type": "string",
          "minLength": 1
        },
        "gaps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "priorKnowledgeRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contextEvidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "../common/common.schema.json#/$defs/EvidenceSource"
      }
    },
    "verification": {
      "$ref": "../common/common.schema.json#/$defs/NodeVerification"
    }
  },
  "x-contractgraph": {
    "purpose": "Assess the learner's current level and gaps from canonical goals/knowledge.",
    "aggregationPath": "baselineAssessment",
    "dependsOn": [],
    "parallelizableWhenReady": true,
    "multiplicity": "single",
    "completionRules": [
      "Output validates against this schema.",
      "status must be complete to accept.",
      "Every learning claim cites a resource.",
      "Producer cannot self-approve."
    ]
  }
}
