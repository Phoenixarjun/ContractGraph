{
  "version": "1.0.0",
  "models": {
    "planning": {
      "draft": "sonnet",
      "supervisor": "opus"
    },
    "research": {
      "primary": "sonnet",
      "triage": "haiku"
    },
    "verification": {
      "section": "sonnet",
      "global": "opus"
    },
    "repair": {
      "structural": "haiku",
      "semantic": "sonnet"
    }
  },
  "execution": {
    "maxParallelNodes": 4,
    "maxRetriesPerNode": 2,
    "retryFailedNodesOnly": true,
    "deterministicAggregation": true,
    "workerCannotSelfApprove": true,
    "concurrencyModes": {
      "default": 4,
      "timeBounded": 8,
      "tokenEfficient": 2
    },
    "tokenEfficientBatching": true,
    "concurrency": {
      "classing": {
        "heavyResearch": "hasWebTools",
        "lightSynthesis": "noWebTools",
        "verifier": "role=section-verifier",
        "globalVerifier": "role=global-verifier"
      },
      "modes": {
        "default": { "heavyResearch": 2, "lightSynthesis": 3, "verifier": 2, "globalVerifier": 1 },
        "tokenEfficient": { "heavyResearch": 1, "lightSynthesis": 2, "verifier": 1, "globalVerifier": 1 },
        "timeBounded": { "heavyResearch": 2, "lightSynthesis": 3, "verifier": 2, "globalVerifier": 1 }
      },
      "note": "heavyResearch stays <=2 in every mode by policy -- time-bounded raises only lightSynthesis/verifier throughput, never research burst size. concurrencyModes above is kept as a legacy aggregate ceiling."
    }
  },
  "evidence": {
    "requireReachableUrls": true,
    "requireClaimLevelEvidence": true,
    "preferPrimarySources": true,
    "candidateReportClaimsRequireQualification": true,
    "singleAnecdoteCannotBecomeFrequencyClaim": true,
    "sourcePriority": [
      "official_regulatory",
      "official",
      "official_documentation",
      "official_engineering",
      "job_posting",
      "research_paper",
      "reputable_news",
      "candidate_report",
      "community"
    ]
  },
  "freshnessDays": {
    "activeJobPosting": 30,
    "hiringSignals": 90,
    "compensation": 180,
    "interviewProcess": 540,
    "recentDevelopments": 180,
    "companyStructure": 365,
    "foundationalEngineeringMaterial": 1825
  },
  "domainLeakage": {
    "note": "Declared by this bundle, read by scripts/validate_domain_leakage.py. The framework core holds no domain vocabulary of its own.",
    "allowedUnconditional": [
      "python", "fastapi", "pydantic", "asyncio", "uvicorn", "pytest",
      "postgresql", "sqlalchemy", "redis", "indexing", "transactions",
      "replication", "sharding", "consistency", "message queue", "kafka",
      "docker", "kubernetes", "observability"
    ],
    "allowedWithLabel": {
      "django": "Adjacent Python web framework — fine as a labelled comparison, not as a substitute track",
      "flask": "Adjacent Python web framework — fine as a labelled comparison",
      "node.js": "Different runtime — fine as a labelled comparison",
      "express": "Different runtime's framework — fine as a labelled comparison",
      "mongodb": "Different data model — fine as a labelled comparison to the relational track",
      "graphql": "Different API style — fine as a labelled comparison to the REST track"
    },
    "disallowed": {},
    "exemptNodes": {
      "databases": ["mongodb"],
      "distributed-systems": ["node.js", "graphql"]
    }
  },
  "privacy": {
    "privateContextMustNotEnterSkills": true,
    "privateContextMustNotEnterPublicExamples": true,
    "derivedContextMustPreserveProvenance": true,
    "canonicalContextIsImmutableDuringRun": true
  },
  "tokenEfficiency": {
    "reuseVerifiedSkills": true,
    "loadContextByRelevance": true,
    "cacheContextSummaries": true,
    "passEvidenceSummariesToOpus": true,
    "doNotPassFullTranscriptsBetweenNodes": true,
    "canonicalFormat": "json",
    "toonMode": "benchmark_before_enable",
    "toon": {
      "mode": "benchmark_before_enable",
      "enabledForRuntime": false,
      "enabledForBenchmarkOnly": true,
      "eligibleArrays": ["resources", "milestones", "checkpoints", "sourceRegistry"],
      "minCharSavingsPct": 15,
      "requireRoundTripLossless": true,
      "requireSchemaValid": true
    }
  }
}
