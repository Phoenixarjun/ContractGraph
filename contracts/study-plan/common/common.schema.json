{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.dev/contracts/study-plan/common/common.schema.json",
  "title": "Study Plan Common Definitions",
  "$defs": {
    "Confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "ResourceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "type"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "type": "string",
          "enum": [
            "course",
            "doc",
            "book",
            "video",
            "practice",
            "article"
          ]
        },
        "free": {
          "type": "boolean"
        }
      }
    },
    "EvidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRef",
        "title",
        "url",
        "sourceType"
      ],
      "properties": {
        "sourceRef": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "official_documentation",
            "course",
            "book",
            "article",
            "community"
          ]
        },
        "publicationDate": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessDate": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      }
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "claims"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "HandoffSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline"
      ],
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "keyFacts": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "NodeVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifiedBy",
        "status"
      ],
      "properties": {
        "verifiedBy": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "pending"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
