# ---------------------------------------------------------------------------
# Private context — never commit its contents.
# ---------------------------------------------------------------------------
context/private/*
!context/private/README.md

# Real canonical ground truth (your own profile, resume, goals, notes).
# The PUBLIC structural example lives under context/synthetic/.
context/canonical/
context/context-manifest.json

# Derived context is produced from verified runs and may contain private facts.
context/derived/*
!context/derived/README.md

# ---------------------------------------------------------------------------
# Runtime artifacts — generated per run, never source.
# ---------------------------------------------------------------------------
runtime/runs/
runtime/outputs/
runtime/cache/
runtime/sections/
runtime/traces/
runtime/telemetry-preflight/
.migrations/

# Legacy flat compiled layout (pre per-bundle directories) and any compiled
# artifact that embeds private context paths.
runtime/compiled/*.json
runtime/compiled/*.yaml
runtime/compiled/*.md
runtime/compiled/context-manifest.json
runtime/compiled/compilation-report.md

# ---------------------------------------------------------------------------
# Private workflow bundles — local-only validation workflows.
# Study-plan is the public demonstration bundle and stays tracked.
# ---------------------------------------------------------------------------
contracts/*-private/
contracts/private/
runtime/compiled/*-private/
runtime/compiled/private/
evals/compilation-cases/*-private.json
evals/compilation-cases/private/

# Subagents are generated by /contractgraph:init from private bundles.
.claude/agents/generated/
.claude/settings.local.json

# Personal long-form working notes with private examples embedded.
/ContractGraph.md

# ---------------------------------------------------------------------------
# Scratch, debug, and one-off investigation scripts.
# ---------------------------------------------------------------------------
_check_*.py
dbg_*.py
*_debug.py
ANCHORED_SUMMARY.md

# ---------------------------------------------------------------------------
# Language / tooling / OS noise
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

.DS_Store
Thumbs.db
desktop.ini

.idea/
.vscode/
*.swp
